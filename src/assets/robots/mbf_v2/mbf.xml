        fullinertia="0.0140758 0.0300982 0.032291 -1.03544e-05 1.89531e-06 -3.2478e-06"/>
      <camera name="tracking" pos="0.846 -1.3 0.316"
        xyaxes="0.866 0.500 0.000 -0.171 0.296 0.940" mode="trackcom"/>
      <camera name="side" pos="0 -1 .3" xyaxes="1 0 0 0 1 2" mode="trackcom"/>
      <camera name="back" pos="-1 0 .3" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <site name="imu" pos="0 0 0" group="5"/>
      <geom name="chassis_visual" mesh="chassis" material="chassis_material" class="visual"/>
      <geom name="chassis_collision" mesh="chassis" class="collision"/>

      <!-- FL -->
      <body name="fl_shoulder_link" pos="0.1835 0.0475 0">
