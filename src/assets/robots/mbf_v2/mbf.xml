<mujoco model="mbf">
  <compiler angle="radian" meshdir="assets" autolimits="true" balanceinertia="true"/>

  <!-- Damping / frictionloss identified from the bench sine logs in data/sysid/
       by scripts/sysid/identify_actuator.py, fit against this MuJoCo plant at
       the env's own 5 ms timestep (7.2 mrad replay RMSE vs 8.7 for the previous
       hand-ported values). These are timestep-specific: refitting at 1 ms wants
       ~25% less damping, so if sim.timestep changes, refit.

       armature is deliberately left at the previous 0.003: the bench data
       cannot identify it. Replay RMSE is flat at 7.2 mrad for armature anywhere
       in 0.0024-0.0060, because a single 1.5 Hz tone cannot separate rotor
       inertia from the (unlogged) bench pose's structural inertia. The
       joint_armature DR range in env_cfgs.py spans that band on purpose.

       PD gains live in mbf_constants.py (Kp=20, Kd=0.5), separate from this
       viscous damping. Do not hand-edit -- rerun the identifier. -->
  <default>
    <default class="robot">
      <default class="shoulder_joint">
        <joint armature="0.003" damping="0.135" frictionloss="0.228"/>
      </default>
      <default class="hip_joint">
        <joint armature="0.003" damping="0.175" frictionloss="0.092"/>
      </default>
      <default class="knee_joint">
        <joint armature="0.003" damping="0.176" frictionloss="0.146"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" contype="1" conaffinity="1" group="3"/>
        <default class="foot">
          <geom type="sphere" size="0.022"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="chassis_material" rgba="0.74902 0.74902 0.74902 1"/>
    <material name="shoulder_material" rgba="0.498039 0.498039 0.498039 1"/>
    <material name="hip_material" rgba="0.498039 0.498039 0.498039 1"/>
    <material name="knee_material" rgba="0.498039 0.498039 0.498039 1"/>
    <material name="feet_material" rgba="0 0 0 1"/>

    <mesh name="chassis" file="chassis.stl"/>
    <mesh name="shoulder" file="shoulder.stl"/>
    <mesh name="lefthip" file="lefthip.stl"/>
    <mesh name="rightthip" file="rightthip.stl"/>
    <mesh name="leftknee" file="leftknee.stl"/>
    <mesh name="rightknee" file="rightknee.stl"/>
    <mesh name="feet" file="feet.stl"/>
  </asset>

  <worldbody>
    <!-- Kinematics / inertias match mbf_description/urdf/mbf.urdf. -->
